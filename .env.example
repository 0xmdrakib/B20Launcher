# Base
BASE_CHAIN_ID=
BASE_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
BASE_BUILDER_CODE=
B20_LAUNCH_ROUTER_ADDRESS=

# Lighthouse IPFS
# Server-only upload credential. The dedicated gateway is used only for retrieval.
LIGHTHOUSE_API_KEY=
LIGHTHOUSE_GATEWAY_URL=https://protective-walrus-h5noy.lighthouseweb3.xyz/ipfs

# Neon staging
DATABASE_URL=

# Durable publication and indexing. GitHub Actions uses short-lived OIDC, so a
# cron secret is only necessary for an alternative trusted scheduler.
CRON_SECRET=
PUBLICATION_DAILY_LIMIT=100
PUBLICATION_WALLET_DAILY_LIMIT=10
INDEXER_INTERVAL_SECONDS=300

# x402 agent API
X402_ENABLED=
# x402 is production-only; Vercel Preview deployments always keep it disabled.
X402_PAY_TO=
X402_PRICE=
X402_NETWORK=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
# Server-only secret; never expose through NEXT_PUBLIC_* or client code.
CDP_API_KEY_SECRET=
